{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MonitoredServices": {
    "Services": [
      { "Name": "orders-service", "BaseUrl": "http://localhost:8080" },
      { "Name": "inventory-service", "BaseUrl": "http://localhost:8081" }
    ]
  },
  "Polling": {
    "IntervalSeconds": 5,
    "PerServiceTimeoutSeconds": 2
  }
}
